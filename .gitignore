.claude/

# single-binary build with the frontend embedded
/artex
# intermediate artifacts the one-click updater leaves next to the executable
# (staged / backup / failed version / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored at the project root, never committed)
/jwt.key

# Local Docker deployment environment (holds passwords/secrets, never committed)
.env

# Scheduler run/simulation event logs (test artifacts, not committed)
*-events.csv

# bench benchmark-related (local artifacts, not committed)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# shinoCTF lab VPN profile (ARTEX player identity, not committed)
/.vpn/

# docker-compose VPN sidecar override (local-only)
/docker-compose.override.yml

# local-only credential notes (never commit)
/.local-credentials.md
